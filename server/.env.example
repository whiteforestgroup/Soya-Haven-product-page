# Copy this file to .env and fill in real values as you set up each service.
# Nothing here is required to run the server locally — every integration
# below no-ops safely (and logs what it *would* do) until its keys are set.

PORT=4000

# The URL your React frontend runs on. Used for CORS and for Stripe's
# success/cancel redirect URLs.
FRONTEND_URL=http://localhost:5173

# --- Stripe (payments) ---------------------------------------------------
# Get these from https://dashboard.stripe.com/apikeys (use test keys while developing)
STRIPE_SECRET_KEY=
# From the Stripe CLI (`stripe listen`) while developing, or from
# Dashboard > Developers > Webhooks once you add a live endpoint.
STRIPE_WEBHOOK_SECRET=

# --- Klaviyo (email: welcome series, abandoned cart, etc.) ---------------
# Account > Settings > API Keys > Create Private Key
KLAVIYO_API_KEY=
# The list new subscribers/checkouts should be added to (Lists & Segments > your list > ID in the URL)
KLAVIYO_LIST_ID=

# --- Meta / Facebook (Pixel + Conversions API) ----------------------------
# Events Manager > your pixel > Settings
META_PIXEL_ID=
META_ACCESS_TOKEN=

# --- Admin dashboard (server/public/admin.html) ---------------------------
# A password for the read-only orders view at /admin.html. Make up any long
# random string, e.g. run: openssl rand -hex 24
ADMIN_TOKEN=

# --- Misc ------------------------------------------------------------------
# How long a checkout can sit unfinished before the abandoned-cart sweep
# picks it up and fires the "Abandoned Checkout" Klaviyo event.
ABANDONED_CART_THRESHOLD_MINUTES=60

# Override where the SQLite file lives (defaults to server/data.sqlite3).
# DATABASE_PATH=
