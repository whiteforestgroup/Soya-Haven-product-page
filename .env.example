# Copy to .env and fill in as you go. Both are optional for local dev —
# checkout falls back to a friendly "not ready yet" message, and no Meta
# Pixel script loads at all until VITE_META_PIXEL_ID is set.

# Where the backend (server/) is running.
VITE_API_URL=http://localhost:4000

# Meta Events Manager > your pixel > Settings
VITE_META_PIXEL_ID=
